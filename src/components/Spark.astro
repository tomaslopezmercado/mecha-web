---
interface Props {
  size?: number;
  color?: string;
  twinkle?: 'a' | 'b' | 'c';
  speed?: number;
  baseOp?: number;
  posStyle: string;
  variant?: 'star' | 'plus';
  strokeWidth?: number;
}

const {
  size = 20,
  color = '#c4f000',
  twinkle = 'a',
  speed = -0.1,
  baseOp = 0.7,
  posStyle,
  variant = 'star',
  strokeWidth,
} = Astro.props;

const sw = strokeWidth ?? (size > 30 ? 3 : size > 20 ? 3.5 : 4);
---

<svg
  class={`spark s-twinkle-${twinkle}`}
  data-speed={speed}
  data-baseop={baseOp}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  style={posStyle}
  aria-hidden="true"
>
  <line x1="20" y1="2" x2="20" y2="38" stroke={color} stroke-width={sw} />
  <line x1="2" y1="20" x2="38" y2="20" stroke={color} stroke-width={sw} />
  {variant === 'star' && <line x1="6" y1="6" x2="34" y2="34" stroke={color} stroke-width={sw} />}
  {variant === 'star' && <line x1="34" y1="6" x2="6" y2="34" stroke={color} stroke-width={sw} />}
</svg>
